+//! Profiling-only control outside the search loops; not part of main.
+use anyhow::Context as _;
+use std::fs::{File, OpenOptions};
+use std::io::{Read as _, Write as _};
+use std::time::{Duration, Instant};
+
+fn command(control: &mut File, ack: &mut File, text: &[u8]) -> anyhow::Result<()> {
+    control.write_all(text)?;
+    control.flush()?;
+    let mut descriptor = libc::pollfd {
+        fd: std::os::fd::AsRawFd::as_raw_fd(ack),
+        events: libc::POLLIN,
+        revents: 0,
+    };
+    // Perf can append a NUL after its newline; consume a complete line
+    // and ignore that terminator before the next acknowledgement.
+    let started = Instant::now();
+    let mut message = Vec::with_capacity(8);
+    while started.elapsed() < Duration::from_secs(30) {
+        // SAFETY: one valid, writable pollfd, held for the call.
+        let ready = unsafe { libc::poll(&raw mut descriptor, 1, 1_000) };
+        if ready < 0 {
+            return Err(std::io::Error::last_os_error().into());
+        }
+        if ready == 0 {
+            continue;
+        }
+        let mut byte = [0u8; 1];
+        ack.read_exact(&mut byte)?;
+        if byte[0] == 0 {
+            continue;
+        }
+        if byte[0] == b'\n' {
+            anyhow::ensure!(
+                message.as_slice() == b"ack",
+                "unexpected perf acknowledgement"
+            );
+            return Ok(());
+        }
+        anyhow::ensure!(message.len() < 16, "perf acknowledgement is too long");
+        message.push(byte[0]);
+    }
+    anyhow::bail!("perf control acknowledgement timed out")
+}
+
+/// Sleep the benchmark duration, controlling perf only when requested.
+/// All control I/O occurs in the supervising thread, outside search code.
+/// Errors are returned so the caller stops and joins its workers.
+pub(super) fn wait(duration: Duration) -> anyhow::Result<()> {
+    let Some(path) = std::env::var_os("EGGPERF_CTL") else {
+        std::thread::sleep(duration);
+        return Ok(());
+    };
+    let ack_path = std::env::var_os("EGGPERF_ACK").context("EGGPERF_ACK is absent")?;
+    let warmup: f64 = std::env::var("EGGPERF_WARMUP")?.parse()?;
+    let warmup = Duration::try_from_secs_f64(warmup)?;
+    anyhow::ensure!(duration > warmup, "profiling window must be positive");
+    let mut control = OpenOptions::new().read(true).write(true).open(path)?;
+    let mut ack = OpenOptions::new().read(true).write(true).open(ack_path)?;
+    std::thread::sleep(warmup);
+    eprintln!("EGGPERF_BEGIN");
+    command(&mut control, &mut ack, b"enable\n")?;
+    let start = Instant::now();
+    std::thread::sleep(
+        duration
+            .checked_sub(warmup)
+            .context("warm-up exceeds duration")?,
+    );
+    command(&mut control, &mut ack, b"disable\n")?;
+    eprintln!(
+        "EGGPERF_WINDOW_SECONDS {:.9}",
+        start.elapsed().as_secs_f64()
+    );
+    Ok(())
+}
